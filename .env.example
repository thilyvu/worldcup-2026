# MongoDB connection string (MongoDB Atlas or local).
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Local:  mongodb://localhost:27017
DATABASE_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Secret used to sign login session cookies. Generate a random one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
